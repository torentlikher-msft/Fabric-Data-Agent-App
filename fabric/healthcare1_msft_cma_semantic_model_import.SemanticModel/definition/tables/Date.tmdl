	column 'Start of Month'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 7cd98db8-fb25-4d2c-b2d5-87f4f394e938
		summarizeBy: none
		isNameInferred
		sourceColumn: [Start of Month]

		variation Variation
			isDefault
			relationship: 6538b7bc-0933-4ea2-8147-8f13cdc6a7fa
			defaultHierarchy: LocalDateTable_1c2e2065-9762-43bf-a82a-848879753a23.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Date = calculated
		mode: import
		source =
				
				VAR _MinDate = DATE(2020, 1, 1)
				VAR _MaxDate = DATE(2030, 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(_MinDate, _MaxDate),
				    "DATE_KEY", YEAR([Date]) * 10000 + MONTH([Date]) * 100 + DAY([Date]),
				    "Year", YEAR([Date]),
				    "Quarter Number", QUARTER([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Year-Quarter", YEAR([Date]) & "-Q" & QUARTER([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Month Short", FORMAT([Date], "MMM"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "Day of Month", DAY([Date]),
				    "Day of Week", WEEKDAY([Date], 2),
				    "Day Name", FORMAT([Date], "dddd"),
				    "Day Short", FORMAT([Date], "ddd"),
				    "Week of Year", WEEKNUM([Date], 2),
				    "Is Weekend", IF(WEEKDAY([Date], 2) >= 6, TRUE(), FALSE()),
				    "Fiscal Year", IF(MONTH([Date]) >= 7, YEAR([Date]) + 1, YEAR([Date])),
				    "Fiscal Quarter", "FQ" & IF(MONTH([Date]) >= 7, QUARTER([Date]) - 2, QUARTER([Date]) + 2),
				    "Start of Month", DATE(YEAR([Date]), MONTH([Date]), 1)
				)

	annotation PBI_Id = d0ca2f43bd7242e290f15d8fbf4f7007

